[
  {
    "name": "璧山来凤鱼",
    "category": "荤菜",
    "ingredients": [
      "草鱼1条",
      "泡辣椒",
      "泡姜",
      "豆瓣酱",
      "干辣椒段",
      "花椒",
      "蒜",
      "姜",
      "料酒",
      "淀粉",
      "盐",
      "食用油"
    ],
    "steps": [
      "草鱼处理干净剁成块，加料酒、盐、淀粉抓匀腌20分钟。",
      "热锅冷油下豆瓣酱、泡辣椒、泡姜、蒜小火炒3分钟炒出红油。",
      "加入高汤大火烧开，下鱼块中火烧8分钟至鱼肉熟透。",
      "大火收汁，沿锅边淋少许料酒去腥。",
      "鱼上铺干辣椒段和花椒，淋一勺烧至冒烟的热油激香即可。"
    ],
