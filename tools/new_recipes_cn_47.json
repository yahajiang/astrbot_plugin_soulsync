  {
    "name": "邮亭鲫鱼",
    "category": "荤菜",
    "ingredients": [
      "鲫鱼3条",
      "泡椒",
      "泡姜",
      "豆瓣酱",
      "芹菜",
      "蒜",
      "花椒",
      "料酒",
      "淀粉",
      "盐",
      "食用油"
    ],
    "steps": [
      "鲫鱼收拾干净，加料酒、盐腌10分钟，表面拍薄淀粉。",
      "油温六成热下鲫鱼，中火煎至两面金黄盛出。",
      "锅留底油爆香豆瓣酱、泡椒、泡姜、蒜，炒2分钟出红油。",
      "下鲫鱼加高汤没过，小火烧10分钟。",
      "大火收汁亮油，撒芹菜段翻匀出锅。"
    ],
