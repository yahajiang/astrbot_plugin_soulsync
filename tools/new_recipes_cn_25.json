 {
  "name": "美式烤肋排",
  "category": "荤菜",
  "ingredients": [
   "猪肋排",
   "红糖",
   "番茄酱",
   "烟熏辣椒粉",
   "蒜粉",
   "洋葱粉",
   "苹果醋",
   "芥末粉",
   "盐",
   "黑胡椒"
  ],
  "steps": [
   "肋排去膜，抹盐、黑胡椒和香料腌2小时。",
   "烤箱150度，肋排包锡纸烤2.5小时至脱骨。",
   "红糖、番茄酱、苹果醋和香料小火熬成烧烤酱。",
   "肋排刷酱，220度烤10分钟，重复刷酱两次。",
   "切块装盘，甜辣焦香、肉嫩脱骨。"
  ],
