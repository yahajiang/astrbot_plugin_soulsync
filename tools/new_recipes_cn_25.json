 {
  "name": "墨西哥牛油果酱",
  "category": "素菜",
  "ingredients": [
   "牛油果",
   "番茄",
   "洋葱",
   "香菜",
   "青柠",
   "小米椒",
   "盐"
  ],
  "steps": [
   "牛油果对半切开，去核挖肉。",
   "用叉子压成带颗粒的泥。",
   "加番茄丁、洋葱丁、香菜碎和小米椒。",
   "挤青柠汁，加盐拌匀。",
   "配玉米片蘸食，绵滑清新、酸辣开胃。"
  ],
