[
 {
  "name": "墨西哥塔可",
  "category": "主食",
  "ingredients": [
   "玉米饼",
   "牛肉末",
   "洋葱",
   "蒜末",
   "辣椒粉",
   "孜然粉",
   "香菜",
   "青柠",
   "番茄莎莎",
   "牛油果",
   "盐"
  ],
  "steps": [
   "牛肉末炒散至焦香，加洋葱蒜末和香料炒匀。",
   "加少量水炖5分钟收汁。",
   "玉米饼平底锅加热至柔软。",
   "饼上铺牛肉，加番茄莎莎、牛油果片。",
   "撒香菜，挤青柠汁，卷起食用，酸辣辛香、馅料满满。"
  ],
