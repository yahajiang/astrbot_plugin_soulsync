 {
  "name": "墨西哥辣酱豆",
  "category": "素菜",
  "ingredients": [
   "黑豆",
   "洋葱",
   "蒜末",
   "番茄",
   "孜然粉",
   "辣椒粉",
   "牛至",
   "盐",
   "橄榄油"
  ],
  "steps": [
   "黑豆浸泡一夜，煮至软烂。",
   "橄榄油炒香洋葱蒜末。",
   "加番茄丁、孜然、辣椒粉和牛至炒香。",
   "下黑豆连煮豆水，小火炖20分钟。",
   "用勺压出一部分豆沙增稠，绵沙咸香、百搭主食。"
  ],
