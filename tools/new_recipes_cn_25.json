 {
  "name": "美式汉堡",
  "category": "主食",
  "ingredients": [
   "牛肉饼",
   "汉堡胚",
   "车打芝士",
   "生菜",
   "番茄",
   "洋葱",
   "酸黄瓜",
   "番茄酱",
   "芥末酱",
   "蛋黄酱"
  ],
  "steps": [
   "牛肉饼双面撒盐，大火煎3分钟至焦香。",
   "翻面铺芝士，盖锅盖焖1分钟至融化。",
   "汉堡胚切开，切面朝下煎至金黄。",
   "抹蛋黄酱和芥末，依次铺生菜、番茄、洋葱圈、酸黄瓜。",
   "放肉饼，挤番茄酱，合盖轻压，肉汁丰盈、一口爆汁。"
  ],
