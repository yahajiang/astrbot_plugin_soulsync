 {
  "name": "墨西哥辣味牛肉汤",
  "category": "汤羹",
  "ingredients": [
   "牛肉",
   "干辣椒",
   "洋葱",
   "蒜",
   "番茄",
   "玉米",
   "土豆",
   "孜然",
   "牛至",
   "香菜",
   "青柠"
  ],
  "steps": [
   "干辣椒烤香泡软，与番茄、洋葱、蒜打成辣酱。",
   "牛肉切块煸炒上色。",
   "加辣酱、孜然和牛至炒香，加水炖1.5小时。",
   "下玉米块和土豆块，再炖20分钟。",
   "撒香菜挤青柠，浓烈辛香、肉烂汤鲜。"
  ],
