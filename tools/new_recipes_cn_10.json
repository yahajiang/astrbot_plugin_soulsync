[
  {
    "name": "北京烤鸭",
    "category": "荤菜",
    "ingredients": ["北京填鸭", "麦芽糖", "蜂蜜", "白醋", "料酒", "甜面酱", "黄瓜丝", "大葱丝", "荷叶饼", "白糖"],
    "steps": [
      "填鸭处理干净，从翅下开口掏出内脏，清水反复灌洗内腔。",
      "麦芽糖、蜂蜜、白醋和料酒调成脆皮水，沸水烫皮后均匀淋满鸭身。",
      "鸭子挂起风干4小时以上至表皮干透紧绷。",
      "烤箱预热200度，鸭胸朝上烤30分钟，翻面烤20分钟至枣红油亮。",
      "静置10分钟，片成皮肉相连的薄片。",
      "荷叶饼抹甜面酱，放鸭片、黄瓜丝和葱丝卷食，皮酥肉嫩、脂香四溢。"
    ],
