  "category": "汤羹",
  "ingredients": [
   "里脊肉150克",
   "榨菜1包",
   "香葱2根",
   "姜3片",
   "淀粉1茶匙",
   "料酒1茶匙",
   "盐少许",
   "白胡椒粉适量",
   "香油几滴"
  ],
