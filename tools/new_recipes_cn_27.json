  {
    "name": "土耳其酸奶汤",
    "category": "汤羹",
    "ingredients": ["酸奶", "鸡蛋", "面粉", "黄油", "干薄荷", "红椒粉", "盐", "热水"],
    "steps": [
      "鸡蛋打散，加酸奶和面粉搅匀。",
      "边搅边冲入热水，入锅小火加热，不停搅拌防结块。",
      "煮至微沸变浓稠，加盐。",
      "黄油融化，加干薄荷和红椒粉炒香。",
      "热油浇入汤中，酸香开胃、奶香柔滑。"
    ],
