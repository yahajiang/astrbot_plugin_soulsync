  {
    "name": "土耳其炖茄子",
    "category": "素菜",
    "ingredients": ["长茄子", "番茄", "洋葱", "蒜末", "青椒", "橄榄油", "番茄膏", "盐", "白糖", "欧芹"],
    "steps": [
      "茄子切条，加盐杀水，煎至金黄。",
      "橄榄油炒香洋葱蒜末，下番茄膏炒出红油。",
      "下番茄丁和青椒块，加水炖10分钟。",
      "放入茄子，再炖10分钟至入味。",
      "加盐和糖调味，撒欧芹，软糯酸甜、油润香浓。"
    ],
