[
  {
    "name": "土耳其烤肉",
    "category": "荤菜",
    "ingredients": ["鸡腿肉", "羊腿肉", "酸奶", "洋葱泥", "蒜末", "孜然粉", "辣椒粉", "牛至", "橄榄油", "盐", "面饼", "生菜", "番茄", "酸奶油酱"],
    "steps": [
      "肉切薄片，用酸奶、洋葱泥、蒜和香料腌4小时。",
      "层层叠在烤肉叉或烤盘上，压紧。",
      "230度烤30分钟至外层焦香，外层片下继续烤。",
      "肉片配生菜、番茄卷入面饼。",
      "淋酸奶酱和辣酱，香辛多汁、肉香浓郁。"
    ],
