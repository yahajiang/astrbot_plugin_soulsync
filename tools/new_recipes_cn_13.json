  {
    "name": "丝娃娃",
    "category": "主食",
    "ingredients": ["面粉", "胡萝卜丝", "黄瓜丝", "豆芽", "折耳根", "酸萝卜丝", "海带丝", "土豆丝", "花生碎", "辣椒油", "香醋", "生抽", "盐"],
    "steps": [
      "面粉加水和成稀面糊，平底锅小火烙成薄如纸的春卷皮。",
