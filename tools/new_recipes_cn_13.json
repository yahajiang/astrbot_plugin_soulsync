  {
    "name": "肠旺面",
    "category": "主食",
    "ingredients": ["鸡蛋面", "猪大肠", "猪血旺", "脆哨（猪油渣）", "豆芽", "红油", "花椒面", "葱花", "姜片", "盐"],
    "steps": [
      "大肠加盐面粉搓洗，焯水后加姜卤煮1小时，捞出切段。",
      "血旺切块，用温水养着防老。",
      "面条煮熟捞入碗中，加焯好的豆芽。",
      "码上肠段、血旺和脆哨，浇红油、花椒面和盐。",
      "冲入滚烫高汤，撒葱花，红汤旺面、肠肥血嫩。"
    ],
