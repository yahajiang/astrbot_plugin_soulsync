  {
    "name": "汽锅鸡",
    "category": "荤菜",
    "ingredients": ["土鸡", "三七花", "枸杞", "姜片", "葱段", "料酒", "盐"],
    "steps": [
      "土鸡斩块，焯水洗净血沫。",
      "鸡块放入汽锅（带中心汽柱的陶锅），加姜片、葱段、料酒和三七花、枸杞。",
      "汽锅不放水，坐在烧开水的锅上，盖严锅盖。",
      "蒸汽通过汽柱进入汽锅，凝成鸡汤，蒸2小时。",
      "加盐调味，汤色金黄清亮，原汁原味、鸡肉酥烂。"
    ],
    "tags": ["滇菜", "汤"],
    "methods": ["蒸"],
    "tools": ["汽锅"],
    "difficulty": "普通",
