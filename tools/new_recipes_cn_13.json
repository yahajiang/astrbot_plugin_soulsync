[
  {
    "name": "过桥米线",
    "category": "主食",
    "ingredients": ["米线", "鸡胸肉片", "猪里脊片", "乌鱼片", "火腿片", "鹌鹑蛋", "韭菜", "豆芽", "豆腐皮", "葱花", "高汤", "盐", "白胡椒粉"],
    "steps": [
      "鸡架猪骨熬成滚烫浓汤，汤面要浮一层滚油保温。",
      "生肉片切薄片，鹌鹑蛋打散，蔬菜洗净切段，豆腐皮切丝。",
      "大碗内壁烫热，先放入生肉片和鹌鹑蛋，用滚汤烫熟。",
      "迅速加入米线，再放蔬菜、豆芽和豆腐皮丝。",
      "加盐和白胡椒粉，撒葱花，先喝汤再吃米线，鲜香滚烫。"
    ],
    "tags": ["滇菜", "主食"],
    "methods": ["烫"],
    "tools": [],
    "difficulty": "普通",
    "bv": "",
    "spicy": false,
    "vegetarian": false,
    "mood_hint": ["喜悦"]
