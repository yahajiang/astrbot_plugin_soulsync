  {
    "name": "凉拌折耳根",
    "category": "凉菜",
    "ingredients": ["折耳根（鱼腥草）", "小米椒", "蒜末", "香菜", "生抽", "香醋", "辣椒油", "白糖", "盐"],
    "steps": [
      "折耳根洗净，掐成小段，用盐腌10分钟杀水。",
      "小米椒切圈，香菜切段，蒜剁末。",
      "调汁：生抽、香醋、辣椒油、白糖、蒜末和小米椒搅匀。",
      "折耳根沥干水分，浇上料汁拌匀。",
      "撒香菜，腌制10分钟入味，脆嫩爽口、微苦回甘。"
    ],
    "tags": ["滇菜", "凉菜"],
