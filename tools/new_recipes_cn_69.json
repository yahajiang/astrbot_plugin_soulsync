[
  {
    "name": "桂花酒酿芋圆捞",
    "category": "甜品零食",
    "ingredients": [
      "荔浦芋头",
      "紫薯",
      "糯米粉",
      "酒酿",
      "干桂花",
      "冰糖",
      "藕粉"
    ],
    "steps": [
      "芋头和紫薯去皮切块，上锅大火蒸20分钟至筷子能轻松扎透。",
      "蒸熟后趁热压成泥，分别加糯米粉和温水揉成光滑面团，搓成小圆子。",
      "水烧开后下圆子，中火煮至全部浮起再煮1分钟，捞出过凉水备用。",
      "锅中加清水和冰糖小火煮化，加入酒酿烧开后转小火煮3分钟，淋入藕粉水勾芡至微稠。",
      "圆子盛入碗中，浇上酒酿汤，撒干桂花即可享用。"
    ],
