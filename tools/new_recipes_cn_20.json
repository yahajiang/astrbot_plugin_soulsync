  {
    "name": "泡菜",
    "category": "素菜",
    "ingredients": ["大白菜", "粗盐", "韩式辣椒粉", "鱼露", "虾酱", "苹果", "梨", "蒜", "姜", "萝卜丝", "韭菜"],
