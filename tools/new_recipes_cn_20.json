  {
    "name": "韩式炸鸡",
    "category": "荤菜",
    "ingredients": ["鸡翅", "鸡腿", "牛奶", "面粉", "淀粉", "鸡蛋", "韩式辣酱", "番茄酱", "蜂蜜", "蒜末", "酱油"],
