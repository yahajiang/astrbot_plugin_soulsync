 {
  "name": "淮安软兜",
  "category": "荤菜",
  "ingredients": [
   "黄鳝脊背肉400克",
   "蒜",
   "姜",
   "葱",
   "料酒",
   "生抽",
   "香醋",
   "白糖",
   "白胡椒",
   "淀粉",
   "猪油"
  ],
  "steps": [
   "黄鳝取脊背肉（软兜），切成长约8厘米的段，用开水焯烫20秒去黏液，捞出沥干。",
   "锅中放猪油烧热，下大量蒜片爆香至微黄，倒入鳝段大火爆炒1分钟至卷曲。",
   "烹料酒，加生抽、白糖、香醋调味，注入半碗高汤烧开，转中火烧3分钟。",
   "淋水淀粉勾芡，撒白胡椒粉和葱花，起锅装盘，鳝肉软嫩如绸、蒜香扑鼻。"
  ],
