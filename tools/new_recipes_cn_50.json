 {
  "name": "烧二冬",
  "category": "素菜",
  "ingredients": [
   "冬笋300克",
   "水发香菇12朵",
   "生抽",
   "老抽",
   "白糖",
   "料酒",
   "素高汤",
   "淀粉",
   "食用油",
   "姜"
  ],
  "steps": [
   "冬笋切片焯水，香菇去蒂，大的对半切开，姜切末。",
   "锅中油烧热，下姜末爆香，倒入笋片和香菇中火煸炒2分钟。",
   "加生抽、老抽、白糖、料酒和素高汤，大火烧开转小火烧8分钟至入味。",
   "淋水淀粉勾薄芡，翻匀出锅，咸鲜微甜、一脆一糯。"
  ],
