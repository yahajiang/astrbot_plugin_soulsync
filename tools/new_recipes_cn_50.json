 {
  "name": "荷叶叫花童鸡",
  "category": "荤菜",
  "ingredients": [
   "三黄鸡1只约1200克",
   "荷叶",
   "料酒",
   "生抽",
   "老抽",
   "蚝油",
   "姜",
   "葱",
   "五香粉",
   "盐",
   "面粉"
  ],
  "steps": [
   "三黄鸡洗净沥干，用料酒、生抽、老抽、蚝油、五香粉、盐揉匀，塞入姜片葱段，冷藏腌渍4小时以上。",
   "干荷叶用温水泡软，将腌好的鸡用荷叶层层包裹，再用保鲜膜裹紧。",
   "面粉加水和成硬面团，擀成厚饼状，把荷叶鸡完整包住，封口捏严。",
   "烤箱预热200度，烤90分钟后取出，敲开面团，剥开荷叶，鸡皮金黄酥脆、肉嫩脱骨，撕开即食。"
  ],
