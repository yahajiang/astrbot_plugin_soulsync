[
  {
    "name": "青梅话梅渍小番茄",
    "category": "凉菜",
    "ingredients": ["小番茄500克", "青梅干6颗", "话梅4颗", "冰糖50克", "柠檬半个", "盐2克", "清水400毫升"],
    "steps": [
      "小番茄去蒂洗净，沸水烫10秒迅速捞出，过凉水后逐粒去皮，沥干备用。",
      "青梅干和话梅用清水冲洗，与冰糖、盐一起放入400毫升清水，小火煮开后再熬5分钟，关火放凉至温手。",
      "柠檬切薄片，与去皮小番茄一同放入干净的保鲜盒，倒入放凉的梅子汁没过番茄。",
      "盖紧盒盖入冰箱冷藏腌制至少4小时，取出盛盘，淋上一点腌汁即可食用。"
    ],
