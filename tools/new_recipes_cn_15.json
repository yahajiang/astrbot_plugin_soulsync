 {
  "name": "车轮饼",
  "category": "甜品零食",
  "ingredients": [
   "低筋面粉",
   "鸡蛋",
   "牛奶",
   "白糖",
   "泡打粉",
   "红豆沙",
   "奶油",
   "食用油"
  ],
  "steps": [
   "鸡蛋加白糖打散，加牛奶搅匀，筛入面粉和泡打粉拌成面糊。",
   "车轮模具刷油，倒入半格面糊。",
   "放红豆沙或奶油馅，再倒入面糊盖满。",
   "合模翻转，烤至两面金黄鼓起。",
   "趁热吃，外脆里软、馅料流心。"
  ],
