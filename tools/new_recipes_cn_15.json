 {
  "name": "煎饼果子",
  "category": "主食",
  "ingredients": [
   "绿豆面",
   "面粉",
   "鸡蛋",
   "油条（薄脆）",
   "甜面酱",
   "辣酱",
   "葱花",
   "香菜",
   "芝麻",
   "生菜"
  ],
  "steps": [
   "绿豆面与面粉按2:1混合，加水和成稀面糊。",
   "平底锅刷油，舀一勺面糊用刮板摊成薄圆饼。",
   "磕鸡蛋抹匀，撒葱花和芝麻，烙至蛋液凝固。",
   "翻面刷甜面酱和辣酱，放薄脆、生菜。",
   "卷起切段，外软里脆、酱香四溢。"
  ],
