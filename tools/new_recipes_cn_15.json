[
 {
  "name": "烤冷面",
  "category": "主食",
  "ingredients": [
   "冷面片",
   "鸡蛋",
   "火腿肠",
   "洋葱",
   "香菜",
   "葱花",
   "蒜蓉辣酱",
   "白糖",
   "香醋",
   "芝麻",
   "食用油"
  ],
  "steps": [
   "平底铁板刷油，放冷面片，小火煎软。",
   "磕入鸡蛋，摊开盖在冷面上，煎至蛋液凝固后翻面。",
   "刷蒜蓉辣酱，撒白糖和香醋。",
   "放火腿肠段、洋葱碎和香菜葱花。",
   "卷起切段装盒，撒芝麻，酱香酸甜、筋道软糯。"
  ],
