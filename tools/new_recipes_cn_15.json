 {
  "name": "卤鸭脖",
  "category": "荤菜",
  "ingredients": [
   "鸭脖",
   "干辣椒",
   "花椒",
   "八角",
   "桂皮",
   "香叶",
   "草果",
   "生抽",
   "老抽",
   "冰糖",
   "料酒",
   "姜片"
  ],
  "steps": [
   "鸭脖洗净，冷水下锅加姜、料酒焯水10分钟，捞出。",
   "锅中加清水，放干辣椒、花椒、八角、桂皮、香叶、草果、生抽、老抽和冰糖烧开。",
   "放入鸭脖，小火卤40分钟。",
   "关火浸泡4小时以上入味。",
   "捞出晾凉斩段，麻辣鲜香、越啃越香。"
  ],
