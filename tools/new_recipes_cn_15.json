 {
  "name": "狼牙土豆",
  "category": "素菜",
  "ingredients": [
   "土豆",
   "辣椒面",
   "花椒面",
   "孜然粉",
   "五香粉",
   "生抽",
   "香醋",
   "葱花",
   "蒜末",
   "食用油"
  ],
  "steps": [
   "土豆去皮，用狼牙刀切成波浪条，泡水去淀粉。",
   "油烧至七成热，下土豆条炸至金黄，捞出控油。",
   "碗中放辣椒面、花椒面、孜然粉、五香粉、生抽和香醋。",
   "倒入土豆条和蒜末，颠盆拌匀。",
   "撒葱花，麻辣香脆、街边味道。"
  ],
