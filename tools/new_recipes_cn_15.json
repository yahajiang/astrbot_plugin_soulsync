 {
  "name": "铁板鱿鱼",
  "category": "荤菜",
  "ingredients": [
   "鱿鱼",
   "洋葱",
   "孜然粉",
   "辣椒面",
   "花椒面",
   "生抽",
   "蚝油",
   "白糖",
   "食用油"
  ],
  "steps": [
   "鱿鱼处理干净，撕去黑膜，切花刀成鱿鱼片。",
   "铁板烧热刷油，放鱿鱼和洋葱丝大火煎炒。",
   "鱿鱼卷曲变色后，加生抽和蚝油翻炒。",
   "撒孜然粉、辣椒面、花椒面和白糖。",
   "炒至表面微焦，香气扑鼻，趁热吃。"
  ],
