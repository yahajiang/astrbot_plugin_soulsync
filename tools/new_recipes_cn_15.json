 {
  "name": "炸鸡柳",
  "category": "荤菜",
  "ingredients": [
   "鸡胸肉",
   "鸡蛋",
   "面包糠",
   "淀粉",
   "料酒",
   "盐",
   "白胡椒粉",
   "五香粉",
   "食用油"
  ],
  "steps": [
   "鸡胸肉切条，加料酒、盐、白胡椒粉和五香粉腌15分钟。",
   "肉条依次裹淀粉、蛋液、面包糠。",
   "油烧至六成热，下鸡柳炸2分钟至金黄，捞出。",
   "升高油温复炸30秒更酥脆。",
   "撒孜然或椒盐，外酥里嫩。"
  ],
