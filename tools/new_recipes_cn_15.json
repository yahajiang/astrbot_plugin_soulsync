 {
  "name": "盐酥鸡",
  "category": "荤菜",
  "ingredients": [
   "鸡胸肉",
   "红薯淀粉",
   "五香粉",
   "蒜末",
   "盐",
   "白胡椒粉",
   "九层塔",
   "鸡蛋",
   "食用油"
  ],
  "steps": [
   "鸡胸肉切块，加蒜末、盐、五香粉和鸡蛋腌20分钟。",
   "肉块裹满红薯淀粉，抖去多余粉末。",
   "油烧至六成热，下鸡块炸3分钟至金黄，捞出。",
   "升高油温，下九层塔炸10秒，再复炸鸡块30秒。",
   "趁热撒盐和白胡椒粉，咸香酥脆、椒盐风味。"
  ],
  "tags": [
