 {
  "name": "糖炒栗子",
  "category": "甜品零食",
  "ingredients": [
   "板栗",
   "白糖",
   "食用油",
   "清水"
  ],
  "steps": [
   "板栗洗净，用刀在顶部划十字口。",
   "板栗倒入锅中，加白糖、油和清水没过板栗。",
   "中火煮至水干，转小火翻炒。",
   "炒至栗壳油亮微焦、开口露仁。",
   "趁热剥食，软糯香甜、满口栗香。"
  ],
