 {
  "name": "糖葫芦",
  "category": "甜品零食",
  "ingredients": [
   "山楂",
   "白糖",
   "冰糖",
   "清水",
   "竹签"
  ],
  "steps": [
   "山楂去蒂洗净，晾干，用竹签串成串。",
   "锅中放白糖、冰糖和清水，小火熬至糖浆冒大泡转小泡，滴入冷水能凝成脆糖。",
   "串好的山楂在糖浆中快速滚一圈。",
   "放案板上冷却定型，糖壳脆亮。",
   "酸甜开胃、晶莹剔透，冬季街头最经典。"
  ],
