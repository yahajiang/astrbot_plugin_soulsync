  {
    "name": "傣味柠檬手撕鸡",
    "category": "荤菜",
    "ingredients": [
      "鸡腿2只",
      "柠檬1个",
      "大芫荽",
      "小米辣",
      "大蒜",
      "洋葱",
      "生姜",
      "鱼露",
      "白糖",
      "盐"
    ],
    "steps": [
      "鸡腿冷水下锅，加姜片和料酒，大火烧开转小火煮18分钟，关火再焖10分钟。",
      "捞出鸡腿放入冰水过凉，彻底凉透后用手撕成细丝。",
      "柠檬挤汁，小米辣、大蒜、大芫荽、洋葱切碎，加鱼露、白糖、盐调成酸辣汁。",
      "料汁倒入鸡丝充分拌匀，盖上保鲜膜冷藏10分钟入味。",
      "装盘后点缀柠檬片和芫荽叶即可。"
    ],
    "tags": [
      "傣味",
      "凉拌",
      "云南菜"
    ],
    "methods": "煮拌",
