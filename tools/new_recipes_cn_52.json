  {
    "name": "苗家红酸汤煮鱼",
    "category": "荤菜",
    "ingredients": [
      "草鱼1条",
      "红酸汤",
      "木姜子油",
      "番茄2个",
      "黄豆芽",
      "嫩豆腐",
      "姜蒜",
      "小米辣",
      "葱花",
      "盐"
    ],
    "steps": [
      "草鱼去鳞去内脏斩块，用盐和姜片腌制15分钟。",
      "锅中倒入红酸汤和清水按1比2混合，大火烧开，放入姜蒜片和几滴木姜子油煮3分钟。",
      "下鱼块保持中火煮8分钟，撇去表面浮沫。",
      "加入番茄块、黄豆芽和嫩豆腐，转小火炖10分钟。",
      "加盐调味，撒小米辣圈和葱花出锅。"
    ],
