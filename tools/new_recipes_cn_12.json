  {
    "name": "油泼面",
    "category": "主食",
    "ingredients": ["高筋面粉", "辣椒面", "蒜末", "葱花", "生抽", "香醋", "盐", "青菜", "豆芽", "食用油"],
    "steps": [
      "面粉加盐和温水揉成面团，醒30分钟，搓条切剂刷油，再醒20分钟。",
