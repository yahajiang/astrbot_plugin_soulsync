  {
    "name": "菲律宾阿斗波",
    "category": "荤菜",
    "ingredients": ["鸡腿", "五花肉", "酱油", "白醋", "蒜末", "黑胡椒粒", "香叶", "白糖", "油"],
    "steps": [
      "鸡腿和五花肉切块，加酱油、醋、蒜、胡椒粒和香叶腌30分钟。",
