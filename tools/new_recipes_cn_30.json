  {
    "name": "捷克烤猪膝",
    "category": "荤菜",
    "ingredients": ["猪前膝", "啤酒", "洋葱", "蒜", "孜然", "黑胡椒", "盐", "蜂蜜", "芥末酱", "酸菜"],
    "steps": [
      "猪膝焯水，加啤酒、洋葱、蒜和香料煮1小时。",
      "捞出擦干，表皮划刀抹盐。",
      "烤箱220度烤30分钟至皮脆。",
      "刷蜂蜜和芥末酱，转180度再烤20分钟。",
      "配酸菜和芥末，皮脆肉烂、啤酒麦香。"
    ],
