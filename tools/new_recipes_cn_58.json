[
  {
    "name": "红糖桂花米糕",
    "category": "甜品零食",
    "ingredients": [
      "大米粉",
      "糯米粉",
      "红糖",
      "干桂花",
      "清水",
      "白糖"
    ],
    "steps": [
      "大米粉与糯米粉按3:1混合，加入白糖和清水搅拌成松散湿润的粉粒，用手搓散后静置20分钟。",
      "粉粒过筛入蒸碗，轻轻铺平刮匀，切忌压实，用筷子在表面划出透气孔。",
      "蒸锅水烧开后放入，中大火蒸15分钟至米糕熟透，筷子插入无生粉。",
      "红糖加少量清水熬成浓稠糖浆，淋在热米糕上，撒干桂花，趁热食用。"
    ],
