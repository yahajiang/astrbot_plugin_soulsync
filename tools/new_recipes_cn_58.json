  {
    "name": "椰蓉红豆糯米糍",
    "category": "甜品零食",
    "ingredients": [
      "糯米粉",
      "玉米淀粉",
      "牛奶",
      "红豆沙",
      "椰蓉",
      "白糖",
      "黄油"
