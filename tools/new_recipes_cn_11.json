  {
    "name": "猪肉炖粉条",
    "category": "荤菜",
    "ingredients": ["五花肉", "红薯粉条", "大白菜", "姜片", "葱段", "八角", "桂皮", "生抽", "老抽", "料酒", "白糖"],
