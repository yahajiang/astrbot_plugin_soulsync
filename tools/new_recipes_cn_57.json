  {
    "name": "鲜虾砂锅粥",
    "category": "粥羹",
    "ingredients": [
      "大米",
      "鲜虾",
      "虾头",
      "姜片",
      "香菇",
      "芹菜粒",
      "盐",
      "白胡椒粉",
      "花生油"
    ],
    "steps": [
      "大米洗净加半勺油腌20分钟，鲜虾去壳留虾头，虾仁开背去虾线，香菇泡发切片。",
      "热锅加一勺油，下虾头小火煸炒3分钟至出红油，加开水煮5分钟滤出虾汤。",
      "砂锅倒入虾汤补足水量烧开，下大米和香菇片，中火煮25分钟至米粒开花。",
      "下虾仁和姜片，中火煮3分钟至虾仁卷曲变红，加盐、白胡椒粉调味。",
      "关火撒芹菜粒，淋半勺花生油增香即成。"
    ],
    "tags": [
      "砂锅粥",
      "海鲜粥",
      "早点"
    ],
