  {
    "name": "新加坡海南鸡饭",
    "category": "主食",
    "ingredients": ["三黄鸡", "大米", "姜", "蒜", "香兰叶", "小黄瓜", "辣椒", "生抽", "芝麻油", "鸡汤"],
    "steps": [
