  {
    "name": "白辣椒炒肉",
    "category": "荤菜",
    "ingredients": [
      "白辣椒",
      "五花肉",
      "蒜瓣",
      "青蒜苗",
      "豆豉",
      "生抽",
      "老抽",
      "白糖",
      "料酒",
      "食用油"
    ],
    "steps": [
      "白辣椒提前用温水泡发30分钟去咸味，挤干水分斜切成段；五花肉切薄片。",
      "锅中少油，中小火将五花肉片煸炒3分钟至出油微黄，盛出备用。",
      "锅留底油，下蒜瓣、豆豉小火炒香30秒，倒入白辣椒段中大火翻炒2分钟至表皮微皱。",
      "回锅五花肉，加生抽、老抽、白糖、料酒，大火翻炒1分钟，撒青蒜苗段翻匀出锅。"
    ],
    "tags": [
      "湘菜",
      "下饭",
      "开胃"
    ],
