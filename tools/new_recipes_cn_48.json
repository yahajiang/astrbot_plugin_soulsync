  {
    "name": "蒜苗炒腊肉",
    "category": "荤菜",
    "ingredients": [
      "湘西腊肉",
      "蒜苗",
      "干辣椒",
      "姜片",
      "蒜片",
      "生抽",
      "白糖",
      "料酒",
      "食用油"
    ],
    "steps": [
      "腊肉切薄片，冷水下锅小火煮10分钟去部分咸味，捞出沥干；蒜苗斜切段，蒜白蒜叶分开放。",
      "热锅少油，中小火煸腊肉片3分钟至出油微卷。",
      "下姜蒜片、干辣椒段炒香，先下蒜白段中火炒1分钟，再下蒜叶段。",
      "加料酒、生抽、少许白糖，大火快炒40秒至蒜苗断生即可出锅。"
    ],
