[
  {
    "name": "冬笋炒腊肉",
    "category": "荤菜",
    "ingredients": [
      "冬笋",
      "湘西腊肉",
      "青蒜苗",
      "干辣椒",
      "姜片",
      "蒜片",
      "料酒",
      "生抽",
      "白糖",
      "食用油"
    ],
    "steps": [
      "腊肉温水泡软后切成约3毫米薄片；冬笋去壳切薄片，冷水下锅加少许盐煮5分钟去涩，捞出沥干。",
      "锅烧热倒少许油，中小火下腊肉片煸炒2-3分钟，煸出肥油至边缘微卷、出油香。",
      "转中大火，下姜蒜片、干辣椒段爆香10秒，倒入冬笋片翻炒2分钟，烹入料酒去腥。",
      "加生抽、白糖调味，大火快炒30秒，撒入青蒜苗段翻炒至断生即可出锅。"
    ],
    "tags": [
      "湘菜",
      "腊味",
      "下饭"
    ],
