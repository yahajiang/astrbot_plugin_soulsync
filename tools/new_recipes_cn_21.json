  {
    "name": "泰式菠萝炒饭",
    "category": "主食",
    "ingredients": ["米饭", "菠萝", "虾仁", "鸡蛋", "青豆", "胡萝卜丁", "腰果", "肉松", "咖喱粉", "鱼露", "洋葱"],
