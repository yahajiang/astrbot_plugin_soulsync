  {
    "name": "冬阴功汤",
    "category": "汤羹",
    "ingredients": ["鲜虾", "草菇", "香茅", "南姜", "柠檬叶", "小米椒", "冬阴功酱", "鱼露", "青柠", "椰浆", "香菜"],
