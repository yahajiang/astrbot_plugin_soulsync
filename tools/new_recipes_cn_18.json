 {
  "name": "桂花藕粉",
  "category": "甜品零食",
  "ingredients": [
   "藕粉",
   "干桂花",
   "白糖",
   "核桃碎",
   "葡萄干",
   "沸水"
  ],
  "steps": [
   "藕粉倒入碗中，加少许凉水调开成糊。",
   "冲入滚烫沸水，快速搅拌至透明胶状。",
   "加白糖拌匀，撒干桂花。",
   "撒核桃碎和葡萄干。",
   "趁热食用，滑润香甜、桂花飘香。"
  ],
