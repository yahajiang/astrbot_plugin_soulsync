 {
  "name": "杏仁豆腐",
  "category": "甜品零食",
  "ingredients": [
   "南杏仁",
   "牛奶",
   "吉利丁片",
   "白糖",
   "糖桂花"
  ],
  "steps": [
   "南杏仁泡发去皮，加牛奶用破壁机打成浆，过滤取汁。",
   "吉利丁片用冰水泡软。",
   "杏仁奶浆加白糖小火加热至微沸，放入吉利丁搅拌融化。",
   "倒入模具，冷藏4小时至凝固。",
   "倒扣脱模，淋糖桂花，嫩滑清甜、杏仁香浓。"
  ],
