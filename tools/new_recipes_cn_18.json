 {
  "name": "冰糖雪梨",
  "category": "甜品零食",
  "ingredients": [
   "雪梨",
   "冰糖",
   "枸杞",
   "红枣"
  ],
  "steps": [
   "雪梨洗净，顶部切开作盖，挖去梨核。",
   "梨盅内放冰糖、红枣和枸杞。",
   "盖上梨盖，用牙签固定。",
   "隔水大火蒸30分钟至梨肉透明软烂。",
   "连汤带梨食用，润肺止咳、清甜滋润。"
  ],
