 {
  "name": "紫薯粥",
  "category": "粥羹",
  "ingredients": [
   "大米",
   "紫薯",
   "冰糖",
   "糯米"
  ],
  "steps": [
   "大米和糯米淘洗浸泡30分钟，紫薯去皮切小丁。",
   "锅中加水烧开，下米，大火煮5分钟。",
   "下紫薯丁，转小火熬20分钟至米烂薯糯。",
   "加冰糖搅拌融化。",
   "粥色淡紫、软糯清甜，暖心早餐。"
  ],
