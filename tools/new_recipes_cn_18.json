 {
  "name": "绿豆沙",
  "category": "甜品零食",
  "ingredients": [
   "绿豆",
   "冰糖",
   "陈皮",
   "清水"
  ],
  "steps": [
   "绿豆洗净，加清水浸泡2小时。",
   "绿豆加足量水和陈皮，大火烧开转小火煮40分钟。",
   "用勺背碾压绿豆，压出细沙。",
   "加冰糖搅拌融化，再煮10分钟至浓稠。",
   "冷藏后更清爽，沙绵清甜、消暑解热。"
  ],
