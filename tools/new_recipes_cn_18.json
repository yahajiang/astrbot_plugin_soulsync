 {
  "name": "芝麻糊",
  "category": "甜品零食",
  "ingredients": [
   "黑芝麻",
   "糯米粉",
   "白糖",
   "牛奶",
   "清水"
  ],
  "steps": [
   "黑芝麻小火炒香，糯米粉小火炒至微黄。",
   "芝麻与糯米粉混合，分次加水用破壁机打成细糊。",
   "糊倒入锅中，小火加热，不断搅拌防糊底。",
   "加白糖和牛奶，煮至浓稠顺滑。",
   "盛碗，撒少许芝麻点缀，香浓丝滑、暖胃养发。"
  ],
  "tags": [
   "甜品",
   "糖水"
  ],
