[
 {
  "name": "银耳莲子羹",
  "category": "甜品零食",
  "ingredients": [
   "干银耳",
   "莲子",
   "红枣",
   "枸杞",
   "冰糖"
  ],
  "steps": [
   "银耳泡发1小时，去蒂撕成小朵；莲子泡软去芯。",
   "银耳加足量清水，大火烧开转小火炖40分钟至出胶。",
   "下莲子、红枣继续炖20分钟。",
   "加冰糖搅拌融化，再炖10分钟。",
   "撒枸杞，关火焖5分钟，胶质浓稠、清甜润喉。"
  ],
