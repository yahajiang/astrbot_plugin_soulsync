 {
  "name": "小米南瓜粥",
  "category": "粥羹",
  "ingredients": [
   "小米",
   "南瓜",
   "枸杞",
   "冰糖"
  ],
  "steps": [
   "小米淘洗干净，南瓜去皮切小块。",
   "锅中加水烧开，下小米，大火煮5分钟。",
   "下南瓜块，转小火熬20分钟至米开花、南瓜软烂。",
   "用勺压碎南瓜，搅拌让粥色金黄。",
   "加枸杞和冰糖，再熬5分钟，绵稠甘甜、养胃暖身。"
  ],
