 {
  "name": "排骨粥",
  "category": "粥羹",
  "ingredients": [
   "大米",
   "猪肋排",
   "姜丝",
   "葱花",
   "料酒",
   "盐",
   "白胡椒粉",
   "香油"
  ],
  "steps": [
   "排骨斩小块，冷水下锅加姜、料酒焯水，捞出洗净。",
   "大米淘洗，与排骨一同入锅，加足量清水。",
   "大火烧开转小火，熬40分钟至米烂骨酥。",
   "加盐和白胡椒粉调味，撒姜丝。",
   "淋香油、撒葱花，鲜香绵滑、暖胃落胃。"
  ],
