 {
  "name": "玉米羹",
  "category": "汤羹",
  "ingredients": [
   "甜玉米粒",
   "鸡蛋",
   "淀粉",
   "白糖",
   "盐",
   "枸杞"
  ],
  "steps": [
   "玉米粒加少量水用料理机打成浆，过滤留汁。",
   "玉米汁入锅，加清水烧开，转小火煮5分钟。",
   "加白糖和少许盐调味。",
   "淋入水淀粉勾芡至浓稠，再淋入蛋液成蛋花。",
   "撒枸杞，甜香滑嫩，老人小孩都爱。"
  ],
