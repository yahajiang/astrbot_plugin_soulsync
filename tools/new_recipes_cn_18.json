 {
  "name": "红枣桂圆汤",
  "category": "甜品零食",
  "ingredients": [
   "红枣",
   "桂圆干",
   "枸杞",
   "红糖",
   "生姜"
  ],
  "steps": [
   "红枣去核，桂圆干剥壳取肉，姜切片。",
   "锅中加水，放红枣、桂圆肉和姜片，大火烧开。",
   "转小火煮20分钟，红枣软烂、桂圆出味。",
   "加红糖和枸杞，搅拌融化，再煮5分钟。",
   "趁热饮用，甜暖补气，冬日暖身。"
  ],
