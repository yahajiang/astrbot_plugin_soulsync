 {
  "name": "八宝粥",
  "category": "粥羹",
  "ingredients": [
   "大米",
   "糯米",
   "红豆",
   "花生",
   "红枣",
   "桂圆",
   "莲子",
   "枸杞",
   "冰糖"
  ],
  "steps": [
   "红豆、莲子、花生提前浸泡3小时，糯米大米淘洗。",
   "所有豆类下锅加水，大火烧开转小火煮30分钟。",
   "下大米、糯米和红枣、桂圆，继续熬30分钟。",
   "粥至浓稠，加冰糖搅拌融化。",
   "撒枸杞，再熬5分钟，料足绵香、甜糯可口。"
  ],
