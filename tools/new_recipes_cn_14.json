  {
    "name": "香茅烤鱼",
    "category": "荤菜",
    "ingredients": ["罗非鱼", "香茅", "小米椒", "蒜瓣", "姜末", "柠檬叶", "鱼露", "盐", "香菜", "食用油"],
    "steps": [
      "罗非鱼处理干净，两面打花刀。",
      "香茅、小米椒、蒜、姜、柠檬叶剁碎，加鱼露和盐调成腌料。",
      "腌料涂满鱼身和腹腔，塞入香茅段，腌制1小时。",
      "鱼用锡纸包好，烤箱200度烤20分钟，打开锡纸再烤5分钟收皮。",
      "配蘸水（鱼露、青柠汁、小米椒、香菜）食用，香茅清香、外焦里嫩。"
    ],
    "tags": ["傣味", "硬菜"],
    "methods": ["烤"],
    "tools": ["烤箱"],
    "difficulty": "普通",
    "bv": "",
    "spicy": true,
    "vegetarian": false,
    "mood_hint": ["喜悦"]
