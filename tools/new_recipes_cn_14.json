  {
    "name": "蒙古奶茶",
    "category": "汤羹",
    "ingredients": ["砖茶", "鲜牛奶", "盐", "黄油", "炒米", "奶皮子"],
    "steps": [
      "砖茶掰碎，加水煮开，煮出浓茶汤，滤去茶渣。",
      "茶汤中倒入鲜牛奶，小火煮开。",
      "加少许盐和黄油，搅拌融化，煮3分钟。",
      "碗中放炒米和奶皮子，冲入滚烫奶茶。",
      "趁热饮用，咸香浓郁、暖身饱腹。"
    ],
