  {
    "name": "藏式酥油茶",
    "category": "汤羹",
    "ingredients": ["砖茶", "酥油", "盐", "核桃仁", "花生"],
    "steps": [
      "砖茶煮成浓茶汤，滤渣留汤。",
      "酥油、盐和核桃仁、花生放入打茶筒。",
      "冲入滚烫茶汤，上下抽打搅打至油茶交融。",
      "倒出趁热饮用，咸香醇厚、暖身驱寒。",
      "高原待客必备，一口入魂。"
