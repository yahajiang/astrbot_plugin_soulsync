[
  {
    "name": "傣味舂鸡脚",
    "category": "荤菜",
    "ingredients": ["鸡脚", "青柠", "小米椒", "蒜瓣", "香菜", "胡萝卜丝", "洋葱丝", "鱼露", "白糖", "盐", "花生碎"],
    "steps": [
      "鸡脚剪去指甲，冷水下锅加姜、料酒煮15分钟，捞出泡冰水至完全冷却。",
      "舂臼中放小米椒、蒜瓣和盐，捣碎出味。",
      "加入鸡脚，轻轻舂打让辣椒入味（不要捣烂）。",
      "加鱼露、白糖、青柠汁和胡萝卜丝、洋葱丝，翻拌均匀。",
      "撒香菜和花生碎，酸辣爽脆、开胃过瘾。"
    ],
    "tags": ["傣味", "凉菜"],
    "methods": ["舂", "拌"],
