  {
    "name": "豉油鸡",
    "category": "荤菜",
    "ingredients": ["三黄鸡1只", "生抽200毫升", "老抽50毫升", "冰糖50克", "八角2颗", "桂皮1段", "姜片5片", "葱段3根", "清水500毫升"],
