[
  {
    "name": "脆皮烧肉",
    "category": "荤菜",
    "ingredients": ["五花肉800克", "粗盐50克", "五香粉1茶匙", "白胡椒粉半茶匙", "白醋2汤匙", "料酒2汤匙", "姜片3片"],
    "steps": [
      "五花肉冷水下锅，加姜片和料酒煮15分钟至八成熟，捞出冲凉沥干。",
      "用竹签在猪皮上密扎小孔，抹匀五香粉和白胡椒粉，猪皮表面涂一层白醋。",
      "猪皮上撒一层粗盐，放入预热200度的烤箱烤30分钟。",
      "刮去猪皮表面的盐壳，转250度再烤15分钟至表皮起泡酥脆。",
      "取出晾凉后切块食用，皮脆肉嫩。"
    ],
