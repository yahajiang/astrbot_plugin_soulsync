  {
    "name": "盐辛鱿鱼",
    "category": "凉菜",
    "ingredients": [
      "鲜鱿鱼",
      "粗盐",
      "清酒",
      "姜",
      "柠檬",
      "紫苏叶"
    ],
    "steps": [
      "鲜鱿鱼处理干净，去掉内脏和软骨，切圈。",
      "鱿鱼用粗盐反复搓洗，冲净后沥干水分。",
      "按鱿鱼重量的3%加入盐，淋清酒，放入姜丝拌匀。",
      "装入密封罐压实，冷藏发酵2天至风味成熟。",
      "食用时取出适量，挤柠檬汁，配紫苏叶直接吃，是经典下酒菜。"
    ],
