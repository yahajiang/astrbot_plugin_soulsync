  {
    "name": "金平牛蒡",
    "category": "素菜",
    "ingredients": [
      "牛蒡",
      "胡萝卜",
      "芝麻油",
      "日式酱油",
      "味醂",
      "白芝麻",
      "辣椒段",
      "糖",
      "米醋"
    ],
    "steps": [
      "牛蒡洗净去皮，切成5厘米长的细丝，泡入加醋的清水防止氧化变色。",
      "胡萝卜切与牛蒡同长的细丝。",
      "锅中倒入芝麻油，中火烧热，下牛蒡丝和胡萝卜丝翻炒2分钟至变软。",
      "加入日式酱油、味醂、糖和辣椒段，转中火翻炒3分钟至汤汁收干。",
      "出锅前撒白芝麻翻匀，冷却后风味更佳。"
    ],
