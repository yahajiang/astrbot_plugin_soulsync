  {
    "name": "日式冷奴豆腐",
    "category": "凉菜",
    "ingredients": [
      "嫩豆腐",
      "小葱",
      "姜",
      "柴鱼花",
      "日式酱油",
      "味醂",
      "海苔丝"
    ],
    "steps": [
      "嫩豆腐取出沥水，用厨房纸轻轻吸干表面水分。",
