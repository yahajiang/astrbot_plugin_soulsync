 {
  "name": "客家酿三宝",
  "category": "荤菜",
  "ingredients": [
   "苦瓜",
   "茄子",
   "豆腐泡",
   "猪肉末",
   "香菇",
   "虾米",
   "淀粉",
   "生抽",
   "盐"
  ],
  "steps": [
   "猪肉末加香菇丁、虾米、淀粉、盐拌打成肉馅。",
