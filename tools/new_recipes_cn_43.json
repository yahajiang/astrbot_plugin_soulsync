 {
  "name": "武平簸箕粄",
  "category": "主食",
  "ingredients": [
   "粘米粉",
   "木薯淀粉",
   "五花肉",
   "豆角",
   "蒜蓉",
   "生抽",
   "食用油",
   "盐"
  ],
  "steps": [
   "五花肉剁成末，豆角切细粒，热锅炒香加盐和生抽成馅。",
   "粘米粉、木薯淀粉加水调成米浆，静置15分钟。",
   "蒸笼铺湿纱布，舀一勺米浆摊匀，大火蒸2分钟至起泡。",
   "取出米皮，放上肉豆角馅卷成圆筒。",
   "淋上蒜蓉生抽油汁，皮薄滑嫩。"
  ],
