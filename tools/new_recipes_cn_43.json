  ]
 },
 {
  "name": "莆田红团",
  "category": "甜品零食",
  "ingredients": [
   "糯米粉",
   "粘米粉",
   "红豆沙",
   "红曲粉",
   "白糖",
   "猪油",
   "粽叶"
  ],
  "steps": [
   "红豆沙分成小团，搓圆备用。",
   "糯米粉、粘米粉与白糖混合，红曲粉用温水化开，揉入粉中成红色面团。",
   "揪面团压成厚圆片，包入红豆沙收口搓圆。",
   "模具内抹薄油，把团子压入印出花纹，脱模放在垫好粽叶的蒸屉上。",
   "蒸锅水开后上屉，中火蒸20分钟，出锅抹一层熟猪油增亮。"
  ],
  "tags": [
   "地方",
