 },
 {
  "name": "连城涮九门头",
  "category": "荤菜",
  "ingredients": [
   "牛里脊",
   "牛肝",
   "牛百叶",
   "牛心管",
   "牛舌",
   "牛腰",
   "芹菜",
   "葱姜蒜",
   "米酒",
   "香油"
  ],
  "steps": [
   "将各牛内脏洗净，牛肝、牛舌切薄片，牛百叶切条，分别用米酒抓腌去腥。",
   "芹菜切段，葱姜蒜切末，分装码盘。",
   "火锅底放姜片，注入高汤或清水烧开，加入适量米酒。",
   "内脏按易熟程度分批下锅，牛肝烫10秒，百叶烫8秒，牛舌烫20秒。",
   "蘸香油、蒜末、生抽调成的料汁食用，脆嫩爽口。"
  ],
