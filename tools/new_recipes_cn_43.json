 {
  "name": "潮州咸水粿",
  "category": "主食",
  "ingredients": [
   "粘米粉",
   "菜脯",
   "虾米",
   "蒜末",
   "食用油",
   "盐",
   "白糖"
  ],
  "steps": [
   "粘米粉加水调成米浆，静置15分钟。",
   "菜脯泡去咸味切细丁，虾米泡软切碎。",
   "热油爆香蒜末，下菜脯丁、虾米炒香，加糖调味成菜脯料。",
   "米浆倒入小茶杯模具，大火蒸15分钟成形，中心凹陷。",
   "脱模后在凹陷处填入炒好的菜脯料，软糯咸香。"
  ],
