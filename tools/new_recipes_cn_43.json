  ]
 },
 {
  "name": "莆田炝粉",
  "category": "主食",
  "ingredients": [
   "兴化细米粉",
   "蛏干",
   "干贝",
   "香菇",
   "五花肉",
   "芥蓝菜",
   "洋葱",
   "生抽",
   "白胡椒",
   "盐"
  ],
  "steps": [
   "蛏干、干贝、香菇分别泡发，蛏干撕丝，香菇切丝，五花肉切薄片。",
   "锅烧热下五花肉煸出油，加入洋葱丝、香菇丝、蛏干、干贝炒香。",
   "注入泡发干货的水与清水，大火煮开转中火煮5分钟成鲜汤。",
   "放入兴化细米粉，用筷子轻轻抖散，中火煮3分钟。",
   "加入芥蓝菜段烫熟，调入盐、生抽和白胡椒，出锅前撒葱花。"
  ],
  "tags": [
   "福建",
   "莆田",
   "地方",
   "早餐"
  ],
  "methods": [
