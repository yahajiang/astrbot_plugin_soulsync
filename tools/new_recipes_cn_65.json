 {
  "name": "卤鸡胗",
  "category": "凉菜",
  "ingredients": [
   "鸡胗400克",
   "生姜",
   "大葱",
   "八角",
   "花椒",
   "干辣椒",
   "生抽",
   "老抽",
   "料酒",
   "盐",
   "白糖"
  ],
  "steps": [
   "鸡胗撕去黄色内膜洗净，表面切十字花刀。",
   "冷水下锅加料酒姜片，大火烧开焯水3分钟，捞出冲净。",
   "卤汤加八角花椒干辣椒小火煮10分钟出味，放入鸡胗小火卤15分钟。",
   "加生抽老抽白糖盐调味，关火浸泡1小时。",
   "捞出晾凉切片，淋辣油撒葱花。"
