 {
  "name": "米凉皮",
  "category": "凉菜",
  "ingredients": [
   "籼米粉200克",
   "红薯淀粉50克",
   "水500克",
   "大蒜",
   "生抽",
   "香醋",
   "香油",
   "盐"
  ],
  "steps": [
   "籼米粉红薯淀粉加500克水调成米浆，静置30分钟。",
   "平盘刷油，倒入薄薄一层米浆摇匀。",
   "大火蒸3分钟至透明。",
   "取出过凉水，揭下凉皮。",
   "切条码盘，淋蒜醋汁拌开。"
  ],
