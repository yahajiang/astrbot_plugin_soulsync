[
 {
  "name": "卤鸡爪",
  "category": "凉菜",
  "ingredients": [
   "鸡爪500克",
   "生姜",
   "大葱",
   "干辣椒",
   "花椒",
   "八角",
   "桂皮",
   "香叶",
   "生抽",
   "老抽",
   "冰糖",
   "料酒"
  ],
  "steps": [
   "鸡爪剪去指甲洗净，冷水下锅加姜片料酒，大火烧开焯水3分钟，捞出冲净沥干。",
   "锅中加足量清水，放入八角桂皮香叶花椒干辣椒葱姜，大火烧开后转小火熬20分钟出香味。",
   "下入鸡爪，加生抽老抽冰糖，大火烧开转小火卤20分钟，关火前加盐调味。",
   "关火后在卤汤中浸泡2小时以上入味，捞出晾凉。",
   "冷藏1小时后食用，皮弹肉糯更爽口。"
  ],
  "tags": [
