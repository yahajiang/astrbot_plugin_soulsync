 {
  "name": "卤牛腱",
  "category": "凉菜",
  "ingredients": [
   "牛腱子1个约800克",
   "生姜",
   "大葱",
   "八角",
   "桂皮",
   "香叶",
   "草果",
   "花椒",
   "生抽",
   "老抽",
   "冰糖",
   "料酒"
  ],
  "steps": [
   "牛腱冷水浸泡1小时去血水，中途换水两次。",
   "冷水下锅加姜葱料酒，大火烧开撇净浮沫，煮5分钟后捞出。",
   "卤汤大火烧开，下牛腱转小火卤1.5小时，用筷子能轻松插入即可。",
   "关火浸泡一夜充分入味，捞出晾凉。",
   "逆纹切薄片，蘸蒜泥生抽汁食用。"
  ],
