 {
  "name": "卤猪耳",
  "category": "凉菜",
  "ingredients": [
   "猪耳朵1只",
   "生姜",
   "大葱",
   "八角",
   "桂皮",
   "香叶",
   "花椒",
   "生抽",
   "老抽",
   "冰糖",
   "料酒",
   "盐"
  ],
  "steps": [
   "猪耳冷水下锅，大火烧开煮5分钟焯水，捞出刮净毛根洗净。",
   "锅中水烧开，加八角桂皮香叶花椒姜葱，转小火熬15分钟成卤汤。",
   "放入猪耳，加生抽老抽冰糖，大火烧开转小火卤40分钟，至筷子能扎透软骨。",
   "关火浸泡2小时入味，捞出趁温热用重物压平。",
   "彻底放凉后切薄片装盘，淋少许卤汁即可。"
  ],
