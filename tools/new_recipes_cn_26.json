[
  {
    "name": "罗宋汤",
    "category": "汤羹",
    "ingredients": ["牛腩", "甜菜根", "卷心菜", "土豆", "胡萝卜", "洋葱", "番茄", "番茄膏", "酸奶油", "香叶", "盐", "黑胡椒"],
    "steps": [
      "牛腩切块焯水，加水炖1小时成牛肉汤。",
      "甜菜根、土豆、胡萝卜切块，洋葱切丝，卷心菜切丝。",
      "黄油炒香洋葱，加甜菜根、番茄膏炒出红油。",
      "炒好的蔬菜倒入牛肉汤，加番茄、卷心菜和土豆，再炖30分钟。",
      "加盐和黑胡椒调味，配酸奶油食用，酸甜浓郁、暖身暖胃。"
    ],
    "tags": ["俄餐", "汤"],
