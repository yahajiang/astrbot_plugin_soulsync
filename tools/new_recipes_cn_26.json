  {
    "name": "俄式酸黄瓜",
    "category": "凉菜",
    "ingredients": ["小黄瓜", "白醋", "水", "盐", "白糖", "莳萝", "大蒜", "黑胡椒粒", "香叶"],
    "steps": [
      "小黄瓜洗净擦干，装密封罐。",
      "加莳萝、蒜瓣、黑胡椒粒和香叶。",
      "白醋、水、盐和糖煮开，放凉。",
      "汁倒入罐中没过黄瓜。",
      "冷藏腌3天，酸脆爽口、解腻开胃。"
    ],
    "tags": ["俄餐", "腌菜"],
