  {
    "name": "俄式牛肉饼",
    "category": "荤菜",
    "ingredients": ["牛肉末", "猪肉末", "洋葱", "面包糠", "牛奶", "鸡蛋", "蒜末", "盐", "黑胡椒", "黄油"],
    "steps": [
      "面包糠泡牛奶至吸收。",
      "牛肉末、猪肉末加洋葱末、蒜末、鸡蛋和泡软面包糠。",
      "加盐和黑胡椒，顺一个方向搅打上劲。",
      "整成厚肉饼，黄油煎至两面金黄，加少量水焖5分钟。",
      "配土豆泥和肉汁，外香里嫩、肉汁饱满。"
    ],
