  {
    "name": "俄式鲱鱼沙拉",
    "category": "凉菜",
    "ingredients": ["腌鲱鱼", "土豆", "胡萝卜", "甜菜根", "鸡蛋", "洋葱", "蛋黄酱", "盐"],
