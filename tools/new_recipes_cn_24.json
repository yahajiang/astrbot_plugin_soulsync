  {
    "name": "西班牙海鲜饭",
    "category": "主食",
    "ingredients": ["西班牙短粒米", "大虾", "青口贝", "鱿鱼", "藏红花", "红椒粉", "番茄", "洋葱", "蒜末", "柠檬", "高汤", "橄榄油", "青豆"],
    "steps": [
