[
  {
    "name": "青椒肉丝",
    "category": "荤菜",
    "ingredients": ["猪里脊肉", "青椒", "红椒", "姜丝", "蒜末", "生抽", "料酒", "盐", "淀粉", "白糖"],
    "steps": [
      "里脊肉切丝，加料酒、生抽和淀粉抓匀腌10分钟。",
      "青红椒去籽切丝，姜切丝，蒜切末。",
      "热锅热油，下肉丝滑炒至变色，盛出。",
      "原锅下姜丝蒜末爆香，下青红椒丝大火翻炒2分钟。",
      "倒回肉丝，加盐和少许白糖，翻炒均匀出锅，清爽下饭。"
    ],
