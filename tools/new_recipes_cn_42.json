  {
    "name": "酸豆角炒鸡丁",
    "category": "荤菜",
    "ingredients": [
      "酸豆角",
      "鸡腿肉",
      "泡椒",
      "姜末",
      "蒜末",
      "生抽",
      "料酒",
      "淀粉",
      "白糖"
    ],
    "steps": [
      "1. 酸豆角泡10分钟去咸，挤干切小粒；泡椒切圈。",
      "2. 鸡腿肉去骨切丁，加料酒、生抽、淀粉抓匀腌10分钟。",
      "3. 热锅冷油下鸡丁滑炒至变色盛出。",
      "4. 下姜蒜末、泡椒炒香，下酸豆角大火炒2分钟。",
      "5. 倒回鸡丁，加白糖、生抽调味，大火翻炒1分钟出锅。"
    ],
