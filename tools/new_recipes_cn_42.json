  {
    "name": "蒜薹炒腊肠",
    "category": "荤菜",
    "ingredients": [
      "腊肠",
      "蒜薹",
      "干辣椒",
      "蒜片",
      "生抽",
      "白糖"
    ],
    "steps": [
      "1. 腊肠上锅蒸10分钟取出切片，蒜薹掐老段洗净切寸段。",
      "2. 炒锅下腊肠片中火煸出油，盛出备用。",
      "3. 留底油爆香蒜片、干辣椒，下蒜薹大火翻炒2分钟至断生。",
      "4. 倒回腊肠，加生抽、少许白糖提鲜，大火翻炒1分钟即可。"
    ],
    "tags": [
      "下饭",
