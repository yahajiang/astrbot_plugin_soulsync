[
  {
    "name": "湘味豆豉炒腊肉",
    "category": "荤菜",
    "ingredients": [
      "湖南腊肉",
      "豆豉",
      "青红尖椒",
      "蒜苗",
      "姜片",
      "蒜末",
      "料酒",
      "生抽"
    ],
    "steps": [
      "1. 腊肉温水洗净，冷水下锅煮15分钟去咸，捞出晾凉切薄片。",
      "2. 青红尖椒斜切圈，蒜苗切段，豆豉略剁。",
      "3. 炒锅不放油，下腊肉片中火煸炒至出油卷边，盛出。",
      "4. 留底油下姜蒜末、豆豉小火炒香，转大火下辣椒圈翻炒30秒。",
      "5. 倒回腊肉，烹料酒、生抽，撒蒜苗段大火快炒30秒出锅。"
    ],
    "tags": [
      "下饭",
      "快手",
      "湘味"
    ],
    "methods": "炒",
    "tools": "炒锅",
    "difficulty": "普通",
