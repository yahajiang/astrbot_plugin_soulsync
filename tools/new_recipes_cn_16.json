 },
 {
  "name": "炒田螺",
  "category": "荤菜",
  "ingredients": [
   "田螺",
   "干辣椒",
   "花椒",
   "姜片",
   "蒜瓣",
   "紫苏叶",
   "豆瓣酱",
   "啤酒",
   "生抽",
   "白糖",
   "料酒"
  ],
  "steps": [
   "田螺剪去尾部，清水滴油养2天吐沙，刷洗干净。",
   "热锅热油，下豆瓣酱、干辣椒、花椒、姜蒜炒出红油。",
   "倒入田螺大火翻炒，烹入料酒和生抽。",
   "倒半罐啤酒没过田螺，加白糖，盖盖焖8分钟。",
   "下紫苏叶翻匀，收汁出锅，麻辣鲜香、嗦得过瘾。"
  ],
