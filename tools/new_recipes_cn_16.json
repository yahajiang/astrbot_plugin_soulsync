 {
  "name": "钵仔糕",
  "category": "甜品零食",
  "ingredients": [
   "粘米粉",
   "澄粉",
   "白糖",
   "红豆",
   "清水"
  ],
  "steps": [
   "粘米粉、澄粉加清水调成粉浆，过滤去颗粒。",
   "白糖加清水煮化，冲入粉浆搅匀。",
   "小碗（钵仔）刷油，放几粒蜜红豆。",
   "倒入粉浆至八分满，上锅大火蒸15分钟。",
   "晾凉后边缘翘起，竹签一插即出，Q弹清甜。"
  ],
