 {
  "name": "炸串",
  "category": "荤菜",
  "ingredients": [
   "鸡柳",
   "里脊肉",
   "豆腐干",
   "年糕",
   "蔬菜（茄子土豆蘑菇）",
   "孜然粉",
   "辣椒面",
   "五香粉",
   "白糖",
   "芝麻",
   "食用油"
  ],
  "steps": [
   "各种食材切块，用竹签穿成串。",
   "调撒料：孜然粉、辣椒面、五香粉、白糖和芝麻拌匀。",
   "油烧至六成热，串串分批下锅炸熟炸透。",
   "捞出控油，趁热刷一层酱或撒满撒料。",
   "外酥里嫩、咸香麻辣，边走边吃。"
  ],
