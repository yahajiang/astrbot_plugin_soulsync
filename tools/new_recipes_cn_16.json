 {
  "name": "糊汤粉",
  "category": "主食",
  "ingredients": [
   "细米粉",
   "鲜鱼",
   "猪骨",
   "胡椒粉",
   "盐",
   "姜片",
   "葱花",
   "油条"
  ],
  "steps": [
   "鱼和猪骨熬成浓稠白汤，捞出鱼骨，鱼肉碾碎回汤中。",
   "汤中加入量白胡椒粉，煮至糊状浓稠。",
   "细米粉下锅烫30秒，捞入碗中。",
   "浇上滚烫糊汤，撒葱花。",
   "配油条撕段泡汤吃，糊香浓滑、鲜辣烫嘴。"
  ],
