[
 {
  "name": "关东煮",
  "category": "荤菜",
  "ingredients": [
   "白萝卜",
   "海带结",
   "竹轮",
   "鱼豆腐",
   "鱼丸",
   "魔芋",
   "溏心蛋",
   "昆布",
   "木鱼花",
   "生抽",
   "盐",
   "白糖"
  ],
  "steps": [
   "昆布泡软，加清水煮出高汤，捞出海带，加木鱼花煮5分钟滤出日式清汤。",
   "清汤加生抽、盐和白糖调成关东煮汤汁。",
   "白萝卜切厚块，与魔芋一起焯水去涩。",
   "所有食材放入汤汁中，小火煮30分钟入味。",
   "连汤装碗，配黄芥末或辣酱，清淡鲜美、暖心暖胃。"
  ],
  "tags": [
