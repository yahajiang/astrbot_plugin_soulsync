 {
  "name": "炸鸡排",
  "category": "荤菜",
  "ingredients": [
   "鸡胸肉",
   "鸡蛋",
   "面包糠",
   "淀粉",
   "盐",
   "白胡椒粉",
   "五香粉",
   "料酒",
   "食用油"
  ],
  "steps": [
   "鸡胸肉片成大片，用刀背拍松，加料酒、盐、白胡椒粉和五香粉腌30分钟。",
   "依次裹淀粉、蛋液、面包糠，压实。",
   "油烧至六成热，下鸡排中火炸4分钟，捞出。",
   "升高油温复炸1分钟至金黄酥脆。",
   "切条，配孜然粉或番茄酱，咔滋作响、肉汁饱满。"
  ],
