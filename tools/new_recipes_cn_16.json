 {
  "name": "水果捞",
  "category": "甜品零食",
  "ingredients": [
   "西瓜",
   "芒果",
   "火龙果",
   "哈密瓜",
   "葡萄",
   "酸奶",
   "椰奶",
   "炼乳",
   "西米",
   "蜜豆"
  ],
  "steps": [
   "西米煮至透明过凉水，各种水果切丁。",
   "酸奶、椰奶和炼乳调成捞汁，冷藏。",
   "碗底铺西米和蜜豆。",
   "堆上五彩水果丁，淋上冰镇捞汁。",
