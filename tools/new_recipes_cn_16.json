 {
  "name": "鸡米花",
  "category": "荤菜",
  "ingredients": [
   "鸡胸肉",
   "鸡蛋",
   "面粉",
   "淀粉",
   "牛奶",
   "盐",
   "白胡椒粉",
   "孜然粉",
   "食用油"
  ],
  "steps": [
   "鸡胸肉切小块，加盐、白胡椒粉和牛奶腌20分钟。",
   "面粉与淀粉按1:1混合，鸡蛋加牛奶打散。",
   "鸡块依次裹粉、蘸蛋液、再裹粉。",
   "油烧至六成热，下鸡米花炸2分钟至金黄，捞出复炸30秒。",
   "撒孜然或蘸番茄酱，外脆里嫩。"
  ],
