 },
 {
  "name": "烤生蚝",
  "category": "荤菜",
  "ingredients": [
   "生蚝",
   "蒜蓉",
   "小米椒",
   "葱花",
   "生抽",
   "蚝油",
   "白糖",
   "食用油"
  ],
  "steps": [
   "生蚝刷净外壳，撬开，留蚝肉和一半壳。",
   "蒜蓉一半炸至金黄，与生蒜蓉、小米椒、生抽、蚝油、白糖混合成蒜蓉酱。",
   "蒜蓉酱铺满蚝肉。",
   "炭火或烤箱200度烤5-8分钟至蒜蓉金黄。",
   "撒葱花，连壳带汁一口嗦，鲜甜爆汁。"
  ],
