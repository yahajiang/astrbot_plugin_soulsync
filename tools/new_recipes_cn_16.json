 },
 {
  "name": "鸡蛋仔",
  "category": "甜品零食",
  "ingredients": [
   "低筋面粉",
   "鸡蛋",
   "牛奶",
   "白糖",
   "玉米淀粉",
   "泡打粉",
   "淡奶油",
   "食用油"
  ],
  "steps": [
   "鸡蛋加白糖打发至发白，加牛奶和淡奶油搅匀。",
   "筛入面粉、玉米淀粉和泡打粉，拌匀成面糊，静置15分钟。",
   "鸡蛋仔模具双面刷油，倒入面糊。",
   "合模中小火烤3分钟，翻面再烤3分钟至金黄。",
   "趁热用风扇吹凉定型，外脆内软、蛋香奶香。"
  ],
