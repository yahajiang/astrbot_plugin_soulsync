 {
  "name": "烤鸡爪",
  "category": "荤菜",
  "ingredients": [
   "鸡爪",
   "蒜蓉",
   "小米椒",
   "生抽",
   "老抽",
   "蚝油",
   "蜂蜜",
   "辣椒面",
   "孜然粉",
   "料酒"
  ],
  "steps": [
   "鸡爪剪甲，冷水下锅加姜、料酒煮15分钟，捞出。",
   "调腌料：生抽、老抽、蚝油、蜂蜜、蒜蓉和小米椒。",
   "鸡爪裹满腌料，腌30分钟。",
   "炭火或烤箱200度烤15分钟，翻面刷蜜汁再烤10分钟。",
   "撒辣椒面和孜然粉，皮糯筋弹、甜辣焦香。"
  ],
