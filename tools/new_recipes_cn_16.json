 },
 {
  "name": "台湾卤肉饭",
  "category": "主食",
  "ingredients": [
   "五花肉",
   "红葱头",
   "香菇",
   "鸡蛋",
   "米饭",
   "冰糖",
   "生抽",
   "老抽",
   "料酒",
   "五香粉",
   "白胡椒粉"
  ],
  "steps": [
   "五花肉切小丁，红葱头切丝炸成金黄葱酥，香菇泡发切丁。",
   "锅中少油，下肉丁煸炒至出油微黄。",
   "加葱酥、香菇丁炒香，烹入料酒，加生抽、老抽、冰糖和五香粉。",
   "加开水没过肉丁，小火卤1小时。",
   "卤蛋切开，浇卤肉在热米饭上，肉丁肥糯、酱香浓郁。"
  ],
  "tags": [
   "台湾",
   "主食",
   "下饭"
  ],
  "methods": [
