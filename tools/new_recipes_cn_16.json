 {
  "name": "烤韭菜",
  "category": "素菜",
  "ingredients": [
   "韭菜",
   "蒜蓉",
   "辣椒面",
   "孜然粉",
   "盐",
   "食用油",
   "生抽"
  ],
  "steps": [
   "韭菜洗净沥干，扎成小把，刷一层油。",
   "炭火或平底锅烤至变软出水。",
   "刷蒜蓉酱（蒜蓉、生抽、盐调匀）。",
   "撒辣椒面和孜然粉，翻面再烤1分钟。",
   "烤韭菜配啤酒，夜市必备，焦香多汁。"
  ],
