  {
    "name": "莲藕排骨汤",
    "category": "汤羹",
    "ingredients": ["粉藕", "猪肋排", "生姜", "小葱", "料酒", "盐", "白胡椒粉"],
    "steps": [
      "排骨斩段，冷水下锅加姜片、料酒焯水5分钟，捞出冲净浮沫。",
      "粉藕去皮切滚刀块，用清水泡10分钟防氧化。",
      "砂锅加足量清水，放排骨和姜片，大火烧开转小火炖40分钟。",
      "下藕块，继续小火炖40分钟至藕粉糯拉丝。",
      "加盐和白胡椒粉调味，撒葱花，汤鲜藕粉，秋冬暖胃。"
    ],
