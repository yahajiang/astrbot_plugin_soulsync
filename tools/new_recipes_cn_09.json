  {
    "name": "清蒸武昌鱼",
    "category": "荤菜",
    "ingredients": ["武昌鱼", "生姜", "小葱", "红椒丝", "蒸鱼豉油", "料酒", "盐", "白胡椒粉", "食用油"],
    "steps": [
