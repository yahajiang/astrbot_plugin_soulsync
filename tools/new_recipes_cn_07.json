  {
    "name": "一品锅",
    "category": "荤菜",
    "ingredients": ["鸡", "鸭", "猪肚", "鲜笋", "干香菇", "蛋饺", "肉圆", "鱼圆", "豆腐", "冬笋", "火腿", "高汤"],
    "steps": [
      "鸡、鸭、猪肚焯水处理，蛋饺、肉圆、鱼圆提前备好。",
