[
  {
    "name": "佛跳墙",
    "category": "荤菜",
    "ingredients": ["鲍鱼", "海参", "鱼翅", "花胶", "干贝", "蹄筋", "猪肚", "鸡", "金华火腿", "香菇", "笋尖", "鸽子蛋", "绍酒", "冰糖"],
    "steps": [
      "鲍鱼、海参、花胶等干海味提前泡发处理，洗净去杂质。",
      "鸡肉、猪肚、蹄筋焯水，火腿切片，鸽子蛋煮熟剥壳。",
      "取大坛（或砂锅），底层铺姜片和葱段，逐层码入所有食材。",
      "倒入绍兴黄酒和上等高汤，加冰糖，坛口用荷叶密封。",
      "文火煨制6小时以上，中途不揭盖。",
      "开坛时香气扑鼻，坛启荤香飘四邻，汤浓味厚。"
    ],
    "tags": ["闽菜", "国宴菜", "硬菜"],
