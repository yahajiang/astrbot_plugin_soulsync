 {
  "name": "冬瓜扇贝清汤",
  "category": "汤羹",
  "ingredients": [
   "冬瓜",
   "扇贝柱",
   "姜丝",
   "小葱",
   "盐",
   "料酒",
   "清水"
  ],
  "steps": [
   "扇贝柱用料酒腌制10分钟，冬瓜去皮切薄片。",
   "锅中水烧开，放姜丝，下冬瓜片中火煮8分钟。",
   "加入扇贝柱，中火煮2分钟至刚熟变白。",
   "转小火加盐调味，保持鲜嫩不柴。",
   "关火撒葱花，盛出即可。"
  ],
