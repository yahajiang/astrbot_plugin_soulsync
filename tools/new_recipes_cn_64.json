 {
  "name": "丝瓜口蘑清汤",
  "category": "汤羹",
  "ingredients": [
   "丝瓜",
   "口蘑",
   "姜片",
   "盐",
   "香油",
   "白胡椒粉",
   "清水"
  ],
  "steps": [
   "丝瓜去皮切滚刀块，口蘑洗净切片，姜切片。",
   "锅中清水烧开，放姜片和口蘑，中火煮5分钟出鲜味。",
   "加入丝瓜块，中火煮4分钟至丝瓜变软。",
   "加盐和白胡椒粉调味，小火再煮1分钟。",
   "关火滴香油，盛出即可。"
  ],
