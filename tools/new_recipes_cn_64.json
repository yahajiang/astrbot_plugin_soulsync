[
 {
  "name": "冬瓜木耳清汤",
  "category": "汤羹",
  "ingredients": [
   "冬瓜",
   "干木耳",
   "生姜",
   "小葱",
   "盐",
   "白胡椒粉",
   "清水"
  ],
  "steps": [
   "干木耳提前泡发2小时，去蒂撕小朵；冬瓜去皮去瓤切薄片，姜切片。",
   "锅中加清水大火烧开，放入姜片和冬瓜片，中火煮8分钟至冬瓜半透明。",
   "加入木耳继续煮5分钟，保持中火，撇去浮沫。",
   "转小火，加盐和白胡椒粉调味，再煮2分钟。",
   "关火撒入葱花，趁热盛出即可。"
  ],
  "tags": [
   "汤羹",
   "清汤",
   "素汤",
