 {
  "name": "木耳笋片清汤",
  "category": "汤羹",
  "ingredients": [
   "干木耳",
   "冬笋",
   "胡萝卜",
   "姜片",
   "盐",
   "白胡椒粉",
   "清水"
  ],
  "steps": [
   "木耳泡发撕小朵，冬笋剥壳切薄片焯水3分钟去涩，胡萝卜切片。",
   "锅中清水烧开，放姜片和笋片，中火煮6分钟。",
   "加入木耳和胡萝卜片，中火再煮5分钟。",
   "加盐和白胡椒粉调味，小火煮2分钟。",
   "关火盛出，汤清味鲜。"
  ],
