 {
  "name": "海底椰无花果炖鸡",
  "category": "汤羹",
  "ingredients": [
   "海底椰",
   "干无花果",
   "老母鸡",
   "姜片",
   "红枣",
   "盐",
   "清水"
  ],
  "steps": [
   "老母鸡斩块焯水6分钟，捞出洗净；海底椰和无花果洗净。",
   "炖盅内放入鸡块、海底椰、无花果、红枣和姜片。",
   "加满热水，盖上盅盖。",
   "蒸锅水开后放入炖盅，中火隔水炖2小时。",
   "加盐调味，取出趁热食用。"
