 {
  "name": "白萝卜海带清汤",
  "category": "汤羹",
  "ingredients": [
   "白萝卜",
   "干海带",
   "生姜",
   "小葱",
   "盐",
   "白胡椒粉",
   "清水"
  ],
  "steps": [
   "干海带泡发洗净切丝，白萝卜去皮切细丝，姜切丝。",
   "锅中加清水，放海带丝和姜丝，大火烧开转中火煮10分钟。",
   "加入萝卜丝，中火继续煮8分钟至萝卜透明软烂。",
   "加盐和白胡椒粉调味，转小火煮2分钟。",
   "撒葱花关火，盛出即成。"
  ],
