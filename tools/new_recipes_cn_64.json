 {
  "name": "淮山薏米老鸭汤",
  "category": "汤羹",
  "ingredients": [
   "老鸭",
   "铁棍山药",
   "薏米",
   "姜片",
   "料酒",
   "盐",
   "清水"
  ],
  "steps": [
   "老鸭斩块冷水下锅，加料酒焯水8分钟，捞出洗净浮沫。",
   "薏米提前浸泡2小时，山药去皮切段泡水防氧化。",
   "砂锅加足量清水，放鸭块、薏米和姜片，大火烧开转小火煲1.5小时。",
   "放入山药段，继续小火煲30分钟至山药绵软。",
   "加盐调味，关火焖15分钟即可。"
  ],
