 {
  "name": "豌豆苗豆腐清汤",
  "category": "汤羹",
  "ingredients": [
   "豌豆苗",
   "嫩豆腐",
   "枸杞",
   "姜丝",
   "盐",
   "香油",
   "清水"
  ],
  "steps": [
   "豌豆苗择去老根洗净，豆腐切小方块，枸杞用温水泡软。",
   "锅中清水烧开，放入姜丝和豆腐块，中火煮3分钟。",
   "下豌豆苗，转大火煮1分钟至颜色翠绿断生。",
   "加盐调味，关火滴两滴香油。",
   "撒上泡软的枸杞，盛出趁热食用。"
  ],
