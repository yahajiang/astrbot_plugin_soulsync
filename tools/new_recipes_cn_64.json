 {
  "name": "番茄西葫芦清汤",
  "category": "汤羹",
  "ingredients": [
   "番茄",
   "西葫芦",
   "洋葱",
   "盐",
   "黑胡椒",
   "橄榄油",
   "清水"
  ],
  "steps": [
   "番茄去皮切块，西葫芦切滚刀块，洋葱切丝。",
   "锅烧热放橄榄油，下洋葱丝小火炒2分钟至透明。",
   "加入番茄块中火翻炒3分钟出汁。",
   "倒入清水烧开，放入西葫芦，中火煮8分钟至软。",
   "加盐和黑胡椒调味，关火盛出。"
  ],
