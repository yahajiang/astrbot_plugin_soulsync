[
  {
    "name": "香椿炒鸡蛋",
    "category": "素菜",
    "ingredients": ["香椿芽", "鸡蛋", "盐", "食用油", "料酒"],
    "steps": [
      "香椿芽洗净，水开下锅焯烫30秒变绿立即捞出，过凉水挤干切碎，焯水可去除亚硝酸盐。",
      "鸡蛋打入碗中，加少许盐和半勺料酒打散，倒入香椿碎拌匀。",
      "热锅倒油，油温六成热时转中火倒入蛋液，待底部凝固后轻轻推炒。",
      "炒至蛋液全部凝固呈金黄色，约2分钟，出锅前尝味补盐即可。"
    ],
    "tags": ["时令", "野菜", "早餐"],
