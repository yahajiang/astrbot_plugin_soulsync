  {
    "name": "卤鸭胗",
    "category": "凉菜",
    "ingredients": [
      "鸭胗",
      "姜",
      "葱",
      "八角",
      "花椒",
      "桂皮",
      "香叶",
      "生抽",
      "老抽",
      "料酒",
      "盐",
      "白糖"
    ],
    "steps": [
      "鸭胗撕去内膜洗净，冷水下锅加姜片、料酒，大火烧开焯水3分钟，捞出冲净浮沫。",
      "卤锅中加水，放入八角、花椒、桂皮、香叶、姜片、葱段，大火烧开后转小火熬20分钟出香味。",
      "放入鸭胗，加生抽、老抽、盐、白糖和料酒，中火烧开转小火卤25分钟。",
      "关火浸泡至少2小时，让鸭胗充分入味，捞出沥干。",
      "放凉后切成薄片，码盘淋少许卤汁即可。"
    ],
    "tags": [
      "凉菜",
      "卤味",
      "下酒"
    ],
