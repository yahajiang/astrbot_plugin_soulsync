[
  {
    "name": "卤牛蹄筋",
    "category": "凉菜",
    "ingredients": [
      "牛蹄筋",
      "姜",
      "葱",
      "八角",
      "桂皮",
      "香叶",
      "干辣椒",
      "生抽",
      "老抽",
      "料酒",
      "冰糖",
      "盐"
    ],
    "steps": [
      "牛蹄筋洗净，冷水下锅，加姜片、葱段、料酒，大火烧开焯水5分钟，捞出冲洗干净。",
      "锅中重新加足量清水，放入焯好的蹄筋，加入八角、桂皮、香叶、干辣椒，大火煮开后转小火炖2小时。",
      "加入生抽、老抽、冰糖和盐调味，继续小火卤40分钟至蹄筋软糯筷子可轻松扎透。",
      "关火后不开盖，让蹄筋在卤汁中浸泡1小时充分入味，取出放凉。",
      "凉透后切片装盘，淋少许卤汁，撒葱花即可。"
    ],
    "tags": [
      "凉菜",
      "卤味",
      "下酒"
    ],
