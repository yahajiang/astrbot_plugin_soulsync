  {
    "name": "糖醋蒜",
    "category": "凉菜",
    "ingredients": [
      "新蒜",
      "米醋",
      "白糖",
      "盐",
      "高度白酒"
    ],
    "steps": [
      "新蒜剥去外层老皮，留一层内皮，剪去蒜须，洗净晾干。",
      "密封罐洗净用开水烫过晾干，确保无油无水。",
      "罐中放入大蒜，加盐和白酒拌匀，倒入米醋至完全没过蒜头，加入白糖搅拌至融化。",
      "盖紧盖子密封，避光存放，室温腌制20-30天。",
      "腌好后取出装盘，酸甜脆嫩，佐粥佐面皆宜。"
    ],
