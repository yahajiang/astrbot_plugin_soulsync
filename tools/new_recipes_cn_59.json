  {
    "name": "卤鸡肝",
    "category": "凉菜",
    "ingredients": [
      "鸡肝",
      "姜",
      "葱",
      "八角",
      "桂皮",
      "香叶",
      "干辣椒",
      "生抽",
      "老抽",
      "料酒",
      "冰糖"
    ],
    "steps": [
      "鸡肝撕去筋膜，用清水浸泡30分钟去除血水，冷水下锅加姜片料酒，大火烧开焯水2分钟捞出。",
      "锅中加水烧开，放八角、桂皮、香叶、干辣椒、姜葱，小火煮15分钟制成卤汤。",
      "放入鸡肝，加生抽、老抽、冰糖，中火烧开后立即转小火煮8分钟。",
      "关火让鸡肝在卤汁中浸泡1小时，捞出晾凉。",
      "切成厚片装盘，淋卤汁、撒葱花即可。"
    ],
