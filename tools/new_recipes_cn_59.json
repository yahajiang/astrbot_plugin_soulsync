  {
    "name": "凉拌花生米",
    "category": "凉菜",
    "ingredients": [
      "花生米",
      "芹菜",
      "胡萝卜",
      "八角",
      "花椒",
      "盐",
      "香油",
      "香醋"
    ],
    "steps": [
      "花生米冷水浸泡2小时，放入锅中加水、八角、花椒、盐，大火烧开转小火煮25分钟。",
      "芹菜切段、胡萝卜切丁，开水焯1分钟捞出过凉水。",
